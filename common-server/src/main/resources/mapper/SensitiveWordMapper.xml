<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wang.commonserver.mapper.SensitiveWordMapper">

    <!-- 动态更新敏感词，只更新非 null 且非空的字段 -->
    <update id="updateSelective" parameterType="com.wang.pojo.entity.SensitiveWord">
        UPDATE sensitive_word
        <set>
            <if test="word != null and word != ''">
                word = #{word},
            </if>
            <if test="category != null">
                category = #{category},
            </if>
            <if test="level != null">
                level = #{level},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 批量查询已存在的敏感词 -->
    <select id="selectByWords" resultType="com.wang.pojo.entity.SensitiveWord">
        SELECT * FROM sensitive_word
        WHERE word IN
        <foreach collection="words" item="word" open="(" separator="," close=")">
            #{word}
        </foreach>
    </select>

    <!-- 批量插入敏感词 -->
    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO sensitive_word (word, category, level, status, source, creator_id, create_time, update_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.word}, #{item.category}, #{item.level}, #{item.status}, #{item.source}, #{item.creatorId}, #{item.createTime}, #{item.updateTime})
        </foreach>
    </insert>

</mapper>